<!DOCTYPE html>
<html>
    <head>
        <title>To-Do List for <%= list.name %></title>
        <link rel="stylesheet" href="/style.css">
    </head>
    <body>
        <h1>To-Do List for <%= list.name %></h1>

         <ul>
            <% for (const task of list.items) { %>
                <form action="/<%= list.name %>/delete" method="post">
                    <label>
                <input type="checkbox" name="task" value="<%= task.task %>"  onclick="this.form.submit()">
                
                
                
               <span><%= task.task %></span>
            </label>
                </form>
                
            <% } %>
            <form action="/<%= list.name %>" method="POST">
            <input type="text" name="task" placeholder="Enter a task">
            <button type="submit">Add Task</button>
        </form>
        </ul>

        

        
    </body>